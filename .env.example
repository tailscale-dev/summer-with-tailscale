
CLIENT_ID=
CLIENT_SECRET=

# Optional, only used by 04-api-is-the-way/end-to-end.sh's `up` command.
# Point sandbox-a/b at an existing tailnet's own OAuth credentials instead
# of provisioning a new one, e.g. to run `up --only sharing` against
# tailnets that weren't created by this script's own `sandboxes` step.
# Each falls back to .state/tailnet-<label>.json when unset, so you only
# need to set the ones a state file doesn't already cover:
#   CLIENT_ID / CLIENT_SECRET  that tailnet's own scoped OAuth client
#                     (needed by every step)
#   TAILNET_ID        that tailnet's id, only needed for the *other*
#                     label's `sharing` step
#   DNS_NAME          that tailnet's MagicDNS suffix, only needed for
#                     `verify`
# SANDBOX_A_CLIENT_ID=
# SANDBOX_A_CLIENT_SECRET=
# SANDBOX_A_TAILNET_ID=
# SANDBOX_A_DNS_NAME=
# SANDBOX_B_CLIENT_ID=
# SANDBOX_B_CLIENT_SECRET=
# SANDBOX_B_TAILNET_ID=
# SANDBOX_B_DNS_NAME=
